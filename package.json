{
  "name": "v-bpm-calc",
  "version": "2.0.0",
  "private": true,
  "description": "Tap tempo BPM calculator made with Vue",
  "homepage": "https://v-bpm-calc.vinayakkulkarni.dev",
  "bugs": {
    "url": "https://github.com/vinayakkulkarni/v-bpm-calc/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinayakkulkarni/v-bpm-calc.git"
  },
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt build && wrangler dev --config .output/server/wrangler.json",
    "deploy": "nuxt build && wrangler deploy --config .output/server/wrangler.json",
    "postinstall": "nuxt prepare",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "nuxt typecheck",
    "test": "vp test run",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "catalog:",
    "nuxt": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
